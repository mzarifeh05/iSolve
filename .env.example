# Optional live-content configuration. Leave BOTH values absent for the verified,
# bundled team/FAQ/gallery/contact content and supplied Google Form; no admin saves.
# A partial/invalid configuration shows an error; DB failures never use bundled data.
# Never add passwords, secret keys, or service-role keys to VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Explicit demo opt-in. `npm run dev:demo` enables it without credentials.
# Production builds always disable demo, even if this variable is accidentally true.
VITE_DEMO_MODE=false
